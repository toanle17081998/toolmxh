# Vietnamese Generative Video Factory Environment Variables

# Google Gemini API (Khuyên dùng: Miễn phí hạn mức cao, cực nhanh)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (Tùy chọn)
OPENAI_API_KEY=your_openai_api_key_here

# Fal.ai API cho Wan 2.1 / FLUX (Tùy chọn cho Cloud GPU)
FAL_KEY=your_fal_key_here

# Replicate API (Tùy chọn)
REPLICATE_API_TOKEN=your_replicate_token_here

# ComfyUI Local hoặc Remote Server
COMFYUI_SERVER_URL=http://127.0.0.1:8188
COMFYUI_WS_URL=ws://127.0.0.1:8188/ws

# Cấu hình mặc định
DEFAULT_LLM_PROVIDER=gemini
DEFAULT_TTS_PROVIDER=edge
DEFAULT_TTS_VOICE=vi-VN-HoaiMyNeural
